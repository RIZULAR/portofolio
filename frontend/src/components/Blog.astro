---
const posts = [
  { title: "Cara Membangun Template Web Reusable dengan Astro v5", desc: "Panduan praktis menyusun komponen modular untuk mempercepat pembuatan aplikasi web.", color: "from-indigo-500 to-violet-600" },
  { title: "Panduan Desain Kartu Bisnis & Branding Modern", desc: "Mengatur hierarki tipografi dan margin warna agar kartu nama tampil elegan.", color: "from-rose-400 to-red-400" },
  { title: "Optimasi Performa Frontend Menggunakan Tailwind CSS v4", desc: "Tips meningkatkan skor Lighthouse dan kecepatan render antarmuka pengguna.", color: "from-neutral-700 to-neutral-900" },
];
---
<section id="blog" class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="max-w-2xl mx-auto text-center mb-10">
    <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Artikel & Catatan</p>
    <h2 class="font-display font-semibold text-2xl sm:text-3xl">Blog Terbaru</h2>
    <p class="mt-3 text-ink-light text-sm leading-relaxed">
      Tulisan singkat seputar pengembangan web, desain antarmuka, dan teknik pemrograman.
    </p>
  </div>
  <div class="grid sm:grid-cols-3 gap-6">
    {posts.map((p) => (
      <article class="bg-white rounded-xl overflow-hidden border border-ink/5 shadow-sm">
        <div class={`h-36 bg-gradient-to-br ${p.color}`}></div>
        <div class="p-5">
          <h3 class="font-display font-semibold text-base mb-2">{p.title}</h3>
          <p class="text-sm text-ink-light leading-relaxed mb-3">{p.desc}</p>
          <a href="#" class="text-brand text-sm font-medium hover:underline">Baca Selengkapnya &rarr;</a>
        </div>
      </article>
    ))}
  </div>
</section>
