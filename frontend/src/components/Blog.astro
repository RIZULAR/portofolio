---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const rawPosts = await getCollection('blogs');
const posts = rawPosts
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map(item => item.data);
---
<section id="blog" class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="max-w-2xl mx-auto text-center mb-10" data-aos="fade-up">
    <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Artikel & Catatan</p>
    <h2 class="font-display font-semibold text-2xl sm:text-3xl">Blog & Publikasi</h2>
    <p class="mt-3 text-ink-light text-sm leading-relaxed">
      Tulisan dan opini seputar UI/UX design, pengembangan web, dan teknologi yang saya publikasikan di Medium.
    </p>
  </div>

  <div class={`grid gap-6 ${posts.length === 1 ? 'max-w-xl mx-auto' : posts.length === 2 ? 'sm:grid-cols-2 max-w-4xl mx-auto' : 'sm:grid-cols-3'}`}>
    {posts.map((p, idx) => (
      <article class="bg-white rounded-xl overflow-hidden border border-ink/5 shadow-sm hover:shadow-md transition-all group flex flex-col justify-between" data-aos="fade-up" data-aos-delay={(idx + 1) * 100}>
        <div>
          <div class="relative h-44 sm:h-48 overflow-hidden bg-slate-100">
            {p.image ? (
              <img 
                src={p.image} 
                alt={p.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                width="600" 
                height="300" 
                loading="lazy" 
                decoding="async" 
              />
            ) : (
              <div class={`w-full h-full bg-gradient-to-br ${p.color}`}></div>
            )}
            <div class="absolute top-3 left-3">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-xs font-medium shadow-sm">
                <Icon name="simple-icons:medium" class="w-3.5 h-3.5" />
                <span>Medium Article</span>
              </span>
            </div>
          </div>
          <div class="p-5">
            <h3 class="font-display font-semibold text-base mb-2 text-ink group-hover:text-brand transition-colors leading-snug">
              {p.title}
            </h3>
            <p class="text-sm text-ink-light leading-relaxed mb-4">
              {p.desc}
            </p>
          </div>
        </div>
        <div class="px-5 pb-5 pt-0">
          <a 
            href={p.link || "https://medium.com/@rizqizulmiaztaalbar"} 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label={`Baca artikel: ${p.title} di Medium`} 
            class="inline-flex items-center gap-1.5 text-brand text-sm font-semibold hover:text-amber-600 transition-colors"
          >
            <span>Baca di Medium</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-8 text-center" data-aos="fade-up">
    <a 
      href="https://medium.com/@rizqizulmiaztaalbar" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="inline-flex items-center gap-2 border border-ink/15 bg-white text-ink text-xs font-semibold px-5 py-2.5 rounded-full hover:border-brand hover:text-brand hover:bg-amber-50 transition-all shadow-xs"
    >
      <Icon name="simple-icons:medium" class="w-4 h-4" />
      <span>Lihat Profil Medium Saya (@rizqizulmiaztaalbar) &rarr;</span>
    </a>
  </div>
</section>

