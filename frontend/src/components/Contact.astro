---
---
<section id="contact" class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="grid lg:grid-cols-2 gap-8">
    <div class="bg-white p-6 sm:p-8 rounded-xl border border-ink/5 shadow-sm" data-aos="fade-right">
      <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Kirim Pesan</p>
      <h2 class="font-display font-semibold text-2xl sm:text-3xl mb-6">Hubungi Saya Langsung</h2>
      
      <!-- Feedback Alert Notification -->
      <div id="contact-feedback" class="hidden mb-4 p-4 rounded-lg text-sm transition-all" role="alert"></div>

      <form id="contact-form" class="space-y-4" aria-label="Formulir kontak">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="contact-name" class="sr-only">Nama Lengkap</label>
            <input 
              id="contact-name" 
              name="name" 
              type="text" 
              placeholder="Nama Lengkap Anda (Wajib)" 
              required
              class="w-full border border-ink/15 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand bg-surface" 
            />
          </div>
          <div>
            <label for="contact-email" class="sr-only">Email</label>
            <input 
              id="contact-email" 
              name="email" 
              type="email" 
              placeholder="Email Anda (Wajib)" 
              required
              class="w-full border border-ink/15 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand bg-surface" 
            />
          </div>
        </div>
        <div>
          <label for="contact-subject" class="sr-only">Subjek Pesan</label>
          <input 
            id="contact-subject" 
            name="subject" 
            type="text" 
            placeholder="Subjek Pesan (Contoh: Tawaran Magang / Diskusi Proyek)" 
            class="w-full border border-ink/15 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand bg-surface" 
          />
        </div>
        <div>
          <label for="contact-message" class="sr-only">Pesan</label>
          <textarea 
            id="contact-message" 
            name="message" 
            placeholder="Tuliskan pesan Anda di sini..." 
            rows="5" 
            required
            class="w-full border border-ink/15 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand bg-surface"
          ></textarea>
        </div>
        <button 
          id="contact-submit-btn" 
          type="submit" 
          class="inline-flex items-center justify-center gap-2 bg-brand text-ink text-sm font-bold tracking-wider uppercase px-8 py-3.5 rounded-lg hover:bg-amber-500 transition-all shadow-md shadow-brand/20 cursor-pointer disabled:opacity-50"
        >
          <span id="btn-text">KIRIM PESAN</span>
          <svg id="btn-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>
    </div>

    <div class="bg-white p-6 sm:p-8 rounded-xl border border-ink/5 shadow-sm" data-aos="fade-left">
      <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Informasi Kontak</p>
      <h2 class="font-display font-semibold text-2xl sm:text-3xl mb-6">Kontak & Alamat</h2>
      <div class="space-y-6">
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-full bg-brand/10 flex items-center justify-center shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <div class="text-sm">
            <p class="text-ink-light">Lokasi</p>
            <p class="font-medium text-ink">Yogyakarta, Indonesia</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-full bg-brand/10 flex items-center justify-center shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <div class="text-sm">
            <p class="text-ink-light">Email</p>
            <a href="mailto:rizqizulmiaztaalbar1@gmail.com" class="font-medium text-ink hover:text-brand transition-colors">rizqizulmiaztaalbar1@gmail.com</a>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-full bg-brand/10 flex items-center justify-center shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          </div>
          <div class="text-sm">
            <p class="text-ink-light">WhatsApp</p>
            <a href="https://wa.me/6281325606084" target="_blank" rel="noopener noreferrer" class="font-medium text-ink hover:text-brand transition-colors">+62 813-2560-6084</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const feedback = document.getElementById('contact-feedback');
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');

    if (!form || !feedback || !submitBtn || !btnText) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = (formData.get('name') as string) || '';
      const email = (formData.get('email') as string) || '';
      const subject = (formData.get('subject') as string) || 'Pesan dari Portofolio';
      const message = (formData.get('message') as string) || '';

      // Tampilkan status loading
      submitBtn.disabled = true;
      btnText.textContent = 'MENGIRIM...';
      feedback.className = 'mb-4 p-4 rounded-lg text-sm bg-amber-50 text-amber-800 border border-amber-200 block';
      feedback.textContent = 'Mempersiapkan pesan Anda...';

      // Format pesan untuk WhatsApp fallback
      const waText = encodeURIComponent(
        `Halo Rizular,\n\nNama: ${name}\nEmail: ${email}\nSubjek: ${subject}\n\nPesan:\n${message}`
      );
      const waUrl = `https://wa.me/6281325606084?text=${waText}`;

      // Buka WhatsApp dengan pesan yang sudah terisi otomatis
      setTimeout(() => {
        feedback.className = 'mb-4 p-4 rounded-lg text-sm bg-emerald-50 text-emerald-800 border border-emerald-200 block';
        feedback.innerHTML = `✓ Pesan Anda telah siap! Mengalihkan ke WhatsApp untuk pengiriman instan. <br/><a href="${waUrl}" target="_blank" class="underline font-semibold mt-1 inline-block">Klik di sini jika WhatsApp tidak terbuka otomatis &rarr;</a>`;
        
        window.open(waUrl, '_blank');
        form.reset();
        submitBtn.disabled = false;
        btnText.textContent = 'KIRIM PESAN';
      }, 600);
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>

