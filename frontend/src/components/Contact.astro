---
---
<section id="contact" class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="grid lg:grid-cols-2 gap-8">
    <div class="bg-white p-6 sm:p-8 rounded-xl border border-ink/5 shadow-sm" data-aos="fade-right">
      <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Kirim Pesan</p>
      <h2 class="font-display font-semibold text-2xl sm:text-3xl mb-6">Hubungi Saya Langsung</h2>
      <form class="space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <input type="text" placeholder="Nama Lengkap Anda (Wajib)" required
            class="w-full border border-ink/15 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand bg-surface" />
          <input type="email" placeholder="Email Anda (Wajib)" required
            class="w-full border border-ink/15 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand bg-surface" />
        </div>
        <input type="text" placeholder="Subjek / Subjek Pesan"
          class="w-full border border-ink/15 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand bg-surface" />
        <textarea placeholder="Pesan Anda" rows="5"
          class="w-full border border-ink/15 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand bg-surface"></textarea>
        <button type="submit" class="bg-brand text-ink text-sm font-bold tracking-wider uppercase px-8 py-3.5 rounded-lg hover:bg-amber-500 transition-colors shadow-md shadow-brand/20">
          KIRIM PESAN
        </button>
      </form>
    </div>

    <div class="bg-white p-6 sm:p-8 rounded-xl border border-ink/5 shadow-sm" data-aos="fade-left">
      <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Informasi Kontak</p>
      <h2 class="font-display font-semibold text-2xl sm:text-3xl mb-6">Kontak & Alamat</h2>
      <div class="space-y-6">
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-full bg-brand/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <div class="text-sm">
              <p class="text-ink-light">Lokasi</p>
              <p class="font-medium text-ink">Makassar, Sulawesi Selatan</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-full bg-brand/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <div class="text-sm">
              <p class="text-ink-light">Email</p>
              <p class="font-medium text-ink">rizqi@rizular.dev</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-full bg-brand/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          </div>
          <div class="text-sm">
              <p class="text-ink-light">WhatsApp</p>
              <p class="font-medium text-ink">+62 852-XXXX-XXXX</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
