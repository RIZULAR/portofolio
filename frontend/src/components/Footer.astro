---
const socials = [
  { name: "Twitter", href: "https://twitter.com/rizular" },
  { name: "GitHub", href: "https://github.com/RIZULAR" },
  { name: "LinkedIn", href: "https://linkedin.com/in/rizular" },
  { name: "Instagram", href: "https://instagram.com/rizular" },
];
---
<footer class="mx-4 lg:mx-8 my-6 p-6 bg-white rounded-xl border border-ink/5 shadow-sm">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-ink-light">
    <p>&copy; {new Date().getFullYear()} Rizular. Hak Cipta Dilindungi Undang-Undang.</p>
    <nav aria-label="Tautan media sosial" class="flex gap-5">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`Profil ${s.name} Rizular`} class="hover:text-brand transition-colors font-medium">{s.name}</a>
      ))}
    </nav>
  </div>
</footer>
