---
<section id="hero" class="relative overflow-hidden bg-white rounded-t-none rounded-b-2xl mx-4 lg:mx-8 mt-0 lg:mt-0 px-6 pt-10 sm:px-10 sm:pt-14 pb-0 grid lg:grid-cols-2 gap-8 items-end border border-ink/5 border-t-0 shadow-sm">
  <!-- Geometric Floating Shapes from Template -->
  <div class="absolute top-6 left-12 w-3 h-3 rounded-full border-2 border-brand pointer-events-none"></div>
  <div class="absolute top-10 left-1/2 w-2.5 h-2.5 rounded-full border-2 border-emerald-400 pointer-events-none"></div>
  <div class="absolute top-12 right-16 w-3 h-3 border-2 border-amber-400 rotate-12 pointer-events-none"></div>
  <div class="absolute bottom-16 left-1/3 w-3 h-3 rounded-full border-2 border-emerald-400 pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 w-3 h-3 border-2 border-blue-400 rotate-45 pointer-events-none"></div>
  <div class="absolute bottom-12 right-12 w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[10px] border-b-rose-400 pointer-events-none"></div>

  <div class="relative z-10 pb-10 sm:pb-14">
    <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl leading-tight text-ink">
      Halo, Saya <br />
      <span class="text-brand">Rizqi Zulmiazta Albar</span> <br />
      Fullstack Web Developer
    </h1>
    <p class="mt-4 text-ink-light max-w-md text-sm sm:text-base leading-relaxed">
      Mahasiswa Teknik Informatika semester 6 yang gemar membangun aplikasi web nyata — menggunakan Vue 3, Astro, Laravel, dan Supabase.
    </p>
    <a href="#contact" class="mt-6 inline-flex items-center gap-2 bg-brand text-ink font-bold text-xs sm:text-sm tracking-wider uppercase px-7 py-3.5 rounded hover:bg-amber-500 transition-colors shadow-md shadow-brand/20">
      <span>HUBUNGI SAYA</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>

  <!-- 3D Interactive Tilt Container -->
  <div class="hero-3d-wrapper relative flex justify-center lg:justify-end z-10 self-end [perspective:1000px] cursor-pointer select-none">
    <div 
      id="hero-3d-card" 
      class="relative max-w-xs sm:max-w-sm lg:max-w-md flex items-end justify-center will-change-transform [transform-style:preserve-3d]"
    >
      <!-- Background Parallax Aura -->
      <div 
        id="hero-3d-aura"
        class="absolute -inset-4 bottom-0 bg-gradient-to-tr from-brand/30 via-amber-300/25 to-transparent rounded-full blur-2xl pointer-events-none [transform:translateZ(-30px)]"
      ></div>

      <!-- Floating 3D Badge Left (Fullstack) -->
      <div 
        class="absolute -left-2 sm:-left-4 top-1/3 bg-white/95 backdrop-blur-md border border-ink/10 shadow-lg px-3 py-1.5 rounded-xl hidden sm:flex items-center gap-2 pointer-events-none [transform:translateZ(45px)]"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-xs font-semibold text-ink">Fullstack Dev</span>
      </div>

      <!-- Floating 3D Badge Right (Tech) -->
      <div 
        class="absolute -right-2 sm:-right-4 top-1/4 bg-white/95 backdrop-blur-md border border-ink/10 shadow-lg px-3 py-1.5 rounded-xl hidden sm:flex items-center gap-2 pointer-events-none [transform:translateZ(55px)]"
      >
        <span class="text-amber-500 font-bold text-xs">⚡</span>
        <span class="text-xs font-semibold text-ink">Vue 3 · Laravel</span>
      </div>

      <!-- Main Cutout Photo -->
      <img
        id="hero-3d-img"
        src="/albar1.webp"
        alt="Rizqi Zulmiazta Albar — Fullstack Web Developer"
        class="w-full h-auto max-h-[460px] object-contain drop-shadow-2xl block -mb-0.5 pointer-events-none [transform:translateZ(25px)]"
        width="400"
        height="500"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<script>
  function initHero3DTilt() {
    const wrapper = document.querySelector<HTMLElement>('.hero-3d-wrapper');
    const card = document.getElementById('hero-3d-card');
    const heroSection = document.getElementById('hero');
    if (!wrapper || !card) return;

    let targetRotateX = 0;
    let targetRotateY = 0;
    let currentRotateX = 0;
    let currentRotateY = 0;
    let isHovering = false;
    let rafId: number | null = null;

    function handleTilt(clientX: number, clientY: number, maxAngle = 18) {
      const rect = wrapper!.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      const percentX = Math.max(-1.2, Math.min(1.2, (clientX - centerX) / (rect.width / 2)));
      const percentY = Math.max(-1.2, Math.min(1.2, (clientY - centerY) / (rect.height / 2)));

      targetRotateY = percentX * maxAngle;
      targetRotateX = -percentY * maxAngle;
    }

    function update() {
      if (!card) return;

      // Linear interpolation for smooth spring physics
      currentRotateX += (targetRotateX - currentRotateX) * 0.12;
      currentRotateY += (targetRotateY - currentRotateY) * 0.12;

      const scale = isHovering ? 1.04 : 1.0;
      card.style.transform = `perspective(1000px) rotateX(${currentRotateX.toFixed(2)}deg) rotateY(${currentRotateY.toFixed(2)}deg) scale3d(${scale}, ${scale}, ${scale})`;

      if (
        Math.abs(targetRotateX - currentRotateX) > 0.01 ||
        Math.abs(targetRotateY - currentRotateY) > 0.01 ||
        isHovering
      ) {
        rafId = requestAnimationFrame(update);
      } else {
        card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
        rafId = null;
      }
    }

    wrapper.addEventListener('mouseenter', () => {
      isHovering = true;
      if (!rafId) rafId = requestAnimationFrame(update);
    });

    wrapper.addEventListener('mousemove', (e) => {
      handleTilt(e.clientX, e.clientY, 20);
      if (!rafId) rafId = requestAnimationFrame(update);
    });

    wrapper.addEventListener('mouseleave', () => {
      isHovering = false;
      targetRotateX = 0;
      targetRotateY = 0;
      if (!rafId) rafId = requestAnimationFrame(update);
    });

    // Subtle ambient tilt when moving mouse anywhere across hero section
    if (heroSection) {
      heroSection.addEventListener('mousemove', (e) => {
        if (!isHovering) {
          handleTilt(e.clientX, e.clientY, 10);
          if (!rafId) rafId = requestAnimationFrame(update);
        }
      });
      heroSection.addEventListener('mouseleave', () => {
        if (!isHovering) {
          targetRotateX = 0;
          targetRotateY = 0;
          if (!rafId) rafId = requestAnimationFrame(update);
        }
      });
    }
  }

  initHero3DTilt();
  document.addEventListener('astro:page-load', initHero3DTilt);
</script>
