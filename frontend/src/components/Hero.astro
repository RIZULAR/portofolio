---
---
<section id="hero" class="relative overflow-hidden bg-white rounded-t-none rounded-b-2xl mx-4 lg:mx-8 mt-0 lg:mt-0 px-6 py-10 sm:px-10 sm:py-14 grid lg:grid-cols-2 gap-8 items-center border border-ink/5 border-t-0 shadow-sm">
  <!-- Geometric Floating Shapes from Template -->
  <div class="absolute top-6 left-12 w-3 h-3 rounded-full border-2 border-brand pointer-events-none"></div>
  <div class="absolute top-10 left-1/2 w-2.5 h-2.5 rounded-full border-2 border-emerald-400 pointer-events-none"></div>
  <div class="absolute top-12 right-16 w-3 h-3 border-2 border-amber-400 rotate-12 pointer-events-none"></div>
  <div class="absolute bottom-16 left-1/3 w-3 h-3 rounded-full border-2 border-emerald-400 pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 w-3 h-3 border-2 border-blue-400 rotate-45 pointer-events-none"></div>
  <div class="absolute bottom-12 right-12 w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[10px] border-b-rose-400 pointer-events-none"></div>

  <div class="relative z-10">
    <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl leading-tight text-ink">
      Saya <br />
      <span class="text-brand">Rizqi Zulmiazta Albar</span> <br />
      Fullstack Web Developer
    </h1>
    <p class="mt-4 text-ink-light max-w-md text-sm sm:text-base leading-relaxed">
      Saya membangun antarmuka web yang cepat, responsif, dan scalable menggunakan ekosistem Vue 3, Astro, Tailwind CSS, dan Laravel / Supabase.
    </p>
    <a href="#contact" class="mt-6 inline-flex items-center gap-2 bg-brand text-ink font-bold text-xs sm:text-sm tracking-wider uppercase px-7 py-3.5 rounded hover:bg-amber-500 transition-colors shadow-md shadow-brand/20">
      <span>HUBUNGI SAYA</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>

  <div class="relative flex justify-center lg:justify-end z-10">
    <div class="relative max-w-xs sm:max-w-sm">
      <img
        src="/Albar.png"
        alt="Rizqi Zulmiazta Albar Fullstack Web Developer"
        class="w-full h-auto object-cover rounded-2xl drop-shadow-md"
      />
    </div>
  </div>
</section>
