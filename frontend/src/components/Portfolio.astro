---
import { getCollection } from 'astro:content';

const rawProjects = await getCollection('projects');
const items = rawProjects
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map(item => item.data);

// Dapatkan daftar kategori unik dari data proyek secara dinamis
const dynamicCategories = ["Semua", ...new Set(items.map(it => it.cat).filter(Boolean))];
---
<section id="portfolio" class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="max-w-2xl mx-auto text-center mb-8" data-aos="fade-up">
    <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Karya Terpilih</p>
    <h2 class="font-display font-semibold text-2xl sm:text-3xl">Portofolio Proyek</h2>
    <p class="mt-3 text-ink-light text-sm leading-relaxed">
      Proyek nyata yang pernah saya bangun — dari aplikasi fullstack, dashboard, hingga landing page profesional.
    </p>
  </div>
  
  <!-- Category Filter Buttons -->
  <div class="flex flex-wrap justify-center gap-2 mb-8 text-sm" data-aos="fade-up" data-aos-delay="100" id="portfolio-filter-container">
    {dynamicCategories.map((c, i) => (
      <button
        type="button"
        data-filter={c}
        aria-label={`Filter portofolio: ${c}`}
        aria-pressed={i === 0 ? "true" : "false"}
        class={`portfolio-filter-btn px-4 py-1.5 rounded-full border transition-all cursor-pointer ${
          i === 0 
            ? "bg-brand text-white border-brand font-medium shadow-sm" 
            : "border-ink/15 text-ink-light hover:border-brand hover:text-brand bg-white"
        }`}
      >
        {c}
      </button>
    ))}
  </div>

  <!-- Project Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4" id="portfolio-grid">
    {items.map((it, idx) => {
      const CardTag = it.link ? 'a' : 'div';
      const linkProps = it.link ? { href: it.link, target: '_blank', rel: 'noopener noreferrer' } : {};
      return (
        <CardTag
          {...linkProps}
          data-category={it.cat}
          class="portfolio-card group relative aspect-square rounded-xl overflow-hidden border border-ink/5 shadow-sm bg-white block cursor-pointer transition-all duration-300"
          data-aos="fade-up"
          data-aos-delay={(idx % 3) * 100}
        >
          {it.image ? (
            <img 
              src={it.image} 
              alt={it.title} 
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
              width="400" 
              height="400" 
              loading="lazy" 
              decoding="async" 
            />
          ) : (
            <div class={`absolute inset-0 bg-gradient-to-br ${it.color}`}></div>
          )}
          <div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/75 transition-all flex flex-col justify-between p-4 opacity-0 group-hover:opacity-100">
            <div class="flex justify-end">
              {it.link && (
                <span class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-white group-hover:bg-brand transition-colors">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </span>
              )}
            </div>
            <div>
              <p class="text-white text-sm font-semibold leading-snug">{it.title}</p>
              <p class="text-white/70 text-xs mt-0.5">{it.cat}</p>
              {it.tech && <p class="text-amber-300 text-[11px] mt-1 font-medium">{it.tech}</p>}
            </div>
          </div>
        </CardTag>
      );
    })}
  </div>
</section>

<script>
  function setupPortfolioFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.portfolio-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.portfolio-card');

    if (!filterButtons.length || !cards.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedCategory = btn.getAttribute('data-filter');

        // Update active styling on buttons
        filterButtons.forEach((b) => {
          b.classList.remove('bg-brand', 'text-white', 'border-brand', 'font-medium', 'shadow-sm');
          b.classList.add('border-ink/15', 'text-ink-light', 'bg-white');
          b.setAttribute('aria-pressed', 'false');
        });

        btn.classList.add('bg-brand', 'text-white', 'border-brand', 'font-medium', 'shadow-sm');
        btn.classList.remove('border-ink/15', 'text-ink-light', 'bg-white');
        btn.setAttribute('aria-pressed', 'true');

        // Filter cards with smooth fade
        cards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          if (selectedCategory === 'Semua' || cardCategory === selectedCategory) {
            card.style.display = 'block';
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'scale(1)';
            }, 10);
          } else {
            card.style.opacity = '0';
            card.style.transform = 'scale(0.95)';
            setTimeout(() => {
              card.style.display = 'none';
            }, 250);
          }
        });
      });
    });
  }

  // Run on initial load and after Astro page transitions
  setupPortfolioFilter();
  document.addEventListener('astro:page-load', setupPortfolioFilter);
</script>
