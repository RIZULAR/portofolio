---
const categories = ["Semua", "Desain UI", "Website Template", "Logo", "Branding"];
const items = [
  { title: "Antarmuka Dashboard Admin", cat: "Desain UI", color: "from-brand to-amber-400" },
  { title: "Identitas Kartu Bisnis", cat: "Branding", color: "from-slate-200 to-slate-300" },
  { title: "Template Portfolio Astro", cat: "Website Template", color: "from-neutral-800 to-neutral-900" },
  { title: "Mockup Kemasan Produk", cat: "Branding", color: "from-rose-200 to-rose-300" },
  { title: "Set Ikon & Logo Vektor", cat: "Logo", color: "from-sky-200 to-sky-300" },
  { title: "Desain Akwarel Brand", cat: "Branding", color: "from-pink-300 to-fuchsia-300" },
  { title: "Bingkai Mockup UI", cat: "Desain UI", color: "from-neutral-300 to-neutral-400" },
  { title: "Tata Letak Brosur Web", cat: "Website Template", color: "from-blue-400 to-cyan-400" },
  { title: "Kit Ikon Aplikasi", cat: "Logo", color: "from-red-300 to-orange-300" },
];
---
<section id="portfolio" class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="max-w-2xl mx-auto text-center mb-8">
    <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Karya Terpilih</p>
    <h2 class="font-display font-semibold text-2xl sm:text-3xl">Portofolio Proyek</h2>
    <p class="mt-3 text-ink-light text-sm leading-relaxed">
      Koleksi karya antarmuka web, aplikasi SPA, dan desain sistem terbaru.
    </p>
  </div>
  <div class="flex flex-wrap justify-center gap-2 mb-8 text-sm">
    {categories.map((c, i) => (
      <button class={`px-4 py-1.5 rounded-full border transition-colors ${i === 0 ? "bg-brand text-white border-brand font-medium" : "border-ink/15 text-ink-light hover:border-brand hover:text-brand"}`}>
        {c}
      </button>
    ))}
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
    {items.map((it) => (
      <div class="group relative aspect-square rounded-xl overflow-hidden border border-ink/5 shadow-sm bg-white">
        <div class={`absolute inset-0 bg-gradient-to-br ${it.color}`}></div>
        <div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/60 transition-colors flex items-end p-4 opacity-0 group-hover:opacity-100">
          <div>
            <p class="text-white text-sm font-medium">{it.title}</p>
            <p class="text-white/70 text-xs">{it.cat}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
