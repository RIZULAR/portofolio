---
const categories = ["Semua", "Frontend", "Fullstack", "UI/UX", "Open Source"];
const items = [
  { title: "Sistem Informasi & Integrasi Magang (Magista)", cat: "Fullstack", color: "from-violet-500 to-purple-600", tech: "Team Project · Fullstack · Vue 3 · Laravel", image: "/magista.webp" },
  { title: "AIR.IN — Platform Irigasi (ITFEST 2026)", cat: "Fullstack", color: "from-sky-400 to-cyan-500", tech: "Kompetisi ITFEST 2026 · Vue 3 · Supabase", image: "/airin_preview.webp", link: "https://itfest-air-in.vercel.app" },
  { title: "Sistem Konversi SKS Magang (Best Research)", cat: "Fullstack", color: "from-amber-400 to-amber-600", tech: "Juara Best Research Hackathon 2024", image: "/HACKATON.webp", link: "https://github.com/RIZULAR/HACKATON" },
  { title: "Portofolio Personal Rizular", cat: "Frontend", color: "from-brand to-amber-400", tech: "Astro · Vue · Tailwind CSS" },
  { title: "Landing Page Produk SaaS", cat: "Frontend", color: "from-slate-700 to-slate-900", tech: "Astro · Tailwind CSS" },
  { title: "Sistem Informasi Akademik", cat: "Fullstack", color: "from-emerald-400 to-teal-500", tech: "Laravel · Inertia.js · Vue" },
  { title: "UI Kit Komponen Vue 3", cat: "Open Source", color: "from-rose-400 to-pink-500", tech: "Vue 3 · TypeScript · Storybook" },
  { title: "Desain Sistem E-Commerce", cat: "UI/UX", color: "from-orange-400 to-amber-500", tech: "Figma · Design System" },
  { title: "REST API Manajemen Konten", cat: "Fullstack", color: "from-blue-500 to-indigo-600", tech: "Laravel · PostgreSQL · JWT" },
];
---
<section id="portfolio" class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="max-w-2xl mx-auto text-center mb-8" data-aos="fade-up">
    <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Karya Terpilih</p>
    <h2 class="font-display font-semibold text-2xl sm:text-3xl">Portofolio Proyek</h2>
    <p class="mt-3 text-ink-light text-sm leading-relaxed">
      Proyek nyata yang pernah saya bangun — dari aplikasi fullstack, dashboard, hingga landing page profesional.
    </p>
  </div>
  <div class="flex flex-wrap justify-center gap-2 mb-8 text-sm" data-aos="fade-up" data-aos-delay="100">
    {categories.map((c, i) => (
      <button
        aria-label={`Filter portofolio: ${c}`}
        aria-pressed={i === 0}
        class={`px-4 py-1.5 rounded-full border transition-colors ${i === 0 ? "bg-brand text-white border-brand font-medium" : "border-ink/15 text-ink-light hover:border-brand hover:text-brand"}`}
      >
        {c}
      </button>
    ))}
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
    {items.map((it, idx) => {
      const CardTag = it.link ? 'a' : 'div';
      const linkProps = it.link ? { href: it.link, target: '_blank', rel: 'noopener noreferrer' } : {};
      return (
        <CardTag
          {...linkProps}
          class="group relative aspect-square rounded-xl overflow-hidden border border-ink/5 shadow-sm bg-white block cursor-pointer"
          data-aos="fade-up"
          data-aos-delay={(idx % 3) * 100}
        >
          {it.image ? (
            <img src={it.image} alt={it.title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" width="400" height="400" loading="lazy" decoding="async" />
          ) : (
            <div class={`absolute inset-0 bg-gradient-to-br ${it.color}`}></div>
          )}
          <div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/75 transition-all flex flex-col justify-between p-4 opacity-0 group-hover:opacity-100">
            <div class="flex justify-end">
              {it.link && (
                <span class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-white group-hover:bg-brand transition-colors">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </span>
              )}
            </div>
            <div>
              <p class="text-white text-sm font-semibold leading-snug">{it.title}</p>
              <p class="text-white/70 text-xs mt-0.5">{it.cat}</p>
              {it.tech && <p class="text-amber-300 text-[11px] mt-1 font-medium">{it.tech}</p>}
            </div>
          </div>
        </CardTag>
      );
    })}
  </div>
</section>
