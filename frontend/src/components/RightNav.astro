---

<aside class="hidden xl:flex flex-col items-center justify-between w-20 py-8 sticky top-0 h-screen shrink-0 bg-white border-l border-ink/10 z-40">
  <!-- Tombol Mode Gelap/Terang (Atas) -->
  <button
    id="theme-toggle"
    class="w-10 h-10 rounded-full flex items-center justify-center text-ink hover:text-brand hover:bg-surface transition-colors cursor-pointer"
    aria-label="Toggle theme"
  >
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
      <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
    </svg>
  </button>

  <!-- Navigasi Ikon Vertikal (Tengah) -->
  <nav class="flex flex-col gap-5 items-center" id="right-nav-container">
    {navItems.map((item, idx) => (
      <div class="relative group flex items-center">
        <!-- Tooltip Bahasa Indonesia -->
        <span class="absolute right-14 px-3 py-1 rounded bg-ink text-white text-xs font-medium whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-md">
          {item.label}
        </span>
        
        <!-- Tombol Ikon -->
        <a
          href={`#${item.id}`}
          data-nav-target={item.id}
          aria-label={`Navigasi ke bagian ${item.label}`}
          class:list={[
            "right-nav-btn w-10 h-10 rounded-full flex items-center justify-center transition-all duration-200",
            idx === 0
              ? "bg-brand text-white shadow-md shadow-brand/30"
              : "bg-surface text-ink-light hover:bg-brand hover:text-white"
          ]}
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
          </svg>
        </a>
      </div>
    ))}
  </nav>

  <div class="w-10 h-10"></div>
</aside>

<script>
  function setupRightNav() {
    const navBtns = document.querySelectorAll<HTMLAnchorElement>('.right-nav-btn');
    if (!navBtns.length) return;

    const activeClasses = ['bg-brand', 'text-white', 'shadow-md', 'shadow-brand/30'];
    const inactiveClasses = ['bg-surface', 'text-ink-light', 'hover:bg-brand', 'hover:text-white'];

    let isClickScrolling = false;
    let clickTimeout: number | undefined;

    function setActive(targetId: string) {
      navBtns.forEach((btn) => {
        const id = btn.getAttribute('data-nav-target');
        if (id === targetId) {
          btn.classList.remove(...inactiveClasses);
          btn.classList.add(...activeClasses);
        } else {
          btn.classList.remove(...activeClasses);
          btn.classList.add(...inactiveClasses);
        }
      });
    }

    // Event Klik: Langsung aktifkan ikon tujuan dan kunci IntersectionObserver sementara
    navBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-nav-target');
        if (targetId) {
          isClickScrolling = true;
          setActive(targetId);

          clearTimeout(clickTimeout);
          clickTimeout = window.setTimeout(() => {
            isClickScrolling = false;
          }, 800);
        }
      });
    });

    // IntersectionObserver: Hanya aktif saat scroll manual (diabaikan saat animasi klik)
    const sectionIds = Array.from(navBtns).map((btn) => btn.getAttribute('data-nav-target')).filter(Boolean) as string[];
    const sections = sectionIds.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];

    if ('IntersectionObserver' in window && sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (isClickScrolling) return; // Kunci: Abaikan section perantara saat animasi smooth scroll klik!

          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setActive(entry.target.id);
            }
          });
        },
        {
          rootMargin: '-20% 0px -60% 0px',
          threshold: 0,
        }
      );

      sections.forEach((sec) => observer.observe(sec));
    }
  }

  document.addEventListener('DOMContentLoaded', setupRightNav);
  document.addEventListener('astro:page-load', setupRightNav);
</script>
