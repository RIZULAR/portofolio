---
const services = [
  {
    title: "Pengembangan Web",
    desc: "Website Properti, E-commerce, Landing Page",
    icon: "M4 6h16M4 12h16M4 18h7",
  },
  {
    title: "Desain UI/UX",
    desc: "Aplikasi Mobile & Antarmuka Web",
    icon: "M9 3v18M15 3v18M3 9h18M3 15h18",
  },
  {
    title: "Pengembangan API & Backend",
    desc: "Integrasi Supabase & Laravel",
    icon: "M9 18V5l12-2v13M9 18a3 3 0 11-6 0 3 3 0 016 0zM21 16a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "Optimasi Performa Web",
    desc: "Kecepatan Akses, SEO & Responsivitas",
    icon: "M6 12h4m-2-2v4M15 11h.01M18 13h.01M17.32 5H6.68a4 4 0 00-3.978 3.59c-.006.052-.01.105-.015.157L2 16a3 3 0 003 3c.75 0 1.42-.32 1.9-.83l1.2-1.17h7.8l1.2 1.17c.48.51 1.15.83 1.9.83a3 3 0 003-3l-.687-7.253c-.005-.052-.009-.105-.015-.157A4 4 0 0017.32 5z",
  },
  {
    title: "Aplikasi Web SPA & MPA",
    desc: "Arsitektur Vue 3, Nuxt & Astro",
    icon: "M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9zM15 13a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "Konsultasi & Maintenance",
    desc: "Pemeliharaan Kode & Strategi Digital",
    icon: "M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z",
  },
];
---
<section id="services" class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="max-w-2xl mx-auto text-center mb-10">
    <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Layanan Saya</p>
    <h2 class="font-display font-semibold text-2xl sm:text-3xl">Spesialisasi & Layanan</h2>
    <p class="mt-3 text-ink-light text-sm leading-relaxed">
      Layanan utama yang saya kerjakan — dari konsep desain awal hingga menjadi produk web siap pakai.
    </p>
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {services.map((s) => (
      <div class="group bg-white border border-ink/5 shadow-sm rounded-xl p-6 hover:border-brand hover:shadow-md transition-all">
        <div class="w-12 h-12 rounded-lg bg-brand/10 flex items-center justify-center mb-4 group-hover:bg-brand transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-base mb-1">{s.title}</h3>
        <p class="text-sm text-ink-light">{s.desc}</p>
      </div>
    ))}
  </div>
</section>
