---
const services = [
  {
    title: "Pengembangan Web Frontend",
    desc: "Landing Page, Dashboard Admin, & Aplikasi Web SPA/MPA",
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    title: "Pengembangan Backend & API",
    desc: "REST API dengan Laravel, autentikasi, & manajemen database",
    icon: "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01",
  },
  {
    title: "Integrasi Supabase & Database",
    desc: "Setup PostgreSQL, Row Level Security, realtime subscription",
    icon: "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4",
  },
  {
    title: "Desain UI/UX ke Kode",
    desc: "Konversi desain Figma menjadi komponen Vue & Astro yang pixel-perfect",
    icon: "M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z",
  },
  {
    title: "Optimasi Performa & SEO",
    desc: "Core Web Vitals, Lighthouse score, lazy loading & image optimization",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    title: "Konsultasi & Code Review",
    desc: "Review arsitektur kode, refactoring, & mentoring junior developer",
    icon: "M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z",
  },
];
---
<section id="services" class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="max-w-2xl mx-auto text-center mb-10" data-aos="fade-up">
    <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Bidang Keahlian</p>
    <h2 class="font-display font-semibold text-2xl sm:text-3xl">Apa yang Bisa Saya Kerjakan</h2>
    <p class="mt-3 text-ink-light text-sm leading-relaxed">
      Teknologi dan bidang yang saya kuasai dan aktif saya terapkan dalam proyek nyata.
    </p>
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {services.map((s, idx) => (
      <div class="group bg-white border border-ink/5 shadow-sm rounded-xl p-6 hover:border-brand hover:shadow-md transition-all" data-aos="fade-up" data-aos-delay={(idx + 1) * 100}>
        <div class="w-12 h-12 rounded-lg bg-brand/10 flex items-center justify-center mb-4 group-hover:bg-brand transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-base mb-1">{s.title}</h3>
        <p class="text-sm text-ink-light">{s.desc}</p>
      </div>
    ))}
  </div>
</section>
