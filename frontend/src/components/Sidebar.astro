---
import { Icon } from "astro-icon/components";

const languages = [
  { name: "Bahasa Indonesia", level: 100 },
  { name: "Bahasa Inggris", level: 75 },
];

const skills = [
  { name: "Vue 3 / Nuxt 3", level: 92 },
  { name: "Astro / HTML / CSS", level: 95 },
  { name: "JavaScript / TypeScript", level: 88 },
  { name: "Tailwind CSS", level: 95 },
  { name: "PHP / Laravel", level: 82 },
  { name: "Supabase / PostgreSQL", level: 78 },
  { name: "Figma", level: 70 },
];

const extraSkills = [
  "Git, GitHub, GitLab",
  "Vite, Webpack, npm",
  "REST API, JSON, Axios",
  "Figma, UI/UX Design",
  "Docker (Basic), Postman",
  "Vercel, IDCloud, Domainesia",
];

const socials = [
  { name: "GitHub", icon: "simple-icons:github", href: "https://github.com/rizular" },
  { name: "LinkedIn", icon: "simple-icons:linkedin", href: "https://linkedin.com/in/rizular" },
  { name: "Instagram", icon: "simple-icons:instagram", href: "https://instagram.com/rizular" },
  { name: "Twitter", icon: "simple-icons:x", href: "https://twitter.com/rizular" },
];
---

<aside class="w-full lg:w-72 shrink-0 bg-white border-r border-ink/10 px-6 py-8 lg:h-screen lg:sticky lg:top-0 lg:overflow-y-auto no-scrollbar">
  <!-- Header Profil & Avatar -->
  <div class="flex flex-col items-center text-center">
    <div class="relative w-32 h-32 rounded-full p-1 bg-gradient-to-tr from-brand to-amber-200 shadow-sm">
      <img
        src="/hero-person.png"
        alt="Profil Rizular"
        class="w-full h-full object-cover rounded-full bg-slate-100"
      />
      <span class="absolute bottom-1 right-2 w-4 h-4 bg-emerald-500 border-2 border-white rounded-full shadow-xs"></span>
    </div>
    <h2 class="mt-4 font-display font-semibold text-lg text-ink">Rizular</h2>
    <p class="text-xs text-ink-light mt-0.5 font-medium">Fullstack Web Developer</p>

    <!-- Tombol Ikon Sosial Media via astro-icon -->
    <div class="flex items-center justify-center gap-2 mt-4">
      {socials.map((s) => (
        <a
          href={s.href}
          class="w-7 h-7 rounded-full bg-brand text-ink flex items-center justify-center hover:bg-amber-500 transition-colors shadow-xs"
          aria-label={s.name}
        >
          <Icon name={s.icon} class="w-3.5 h-3.5" />
        </a>
      ))}
    </div>
  </div>

  <!-- Informasi Diri -->
  <div class="border-t border-b border-ink/10 py-5 my-6 space-y-2.5 text-xs">
    <div class="flex justify-between items-center">
      <span class="bg-brand text-ink font-semibold px-2 py-0.5 rounded text-[11px]">Semester:</span>
      <span class="font-normal text-ink">Semester 6</span>
    </div>
    <div class="flex justify-between items-center">
      <span class="bg-brand text-ink font-semibold px-2 py-0.5 rounded text-[11px]">Domisili:</span>
      <span class="font-normal text-ink">Yogyakarta, ID</span>
    </div>
    <div class="flex justify-between items-center">
      <span class="bg-brand text-ink font-semibold px-2 py-0.5 rounded text-[11px]">Status:</span>
      <span class="text-emerald-500 font-medium">Mahasiswa Aktif</span>
    </div>
    <div class="flex justify-between items-center">
      <span class="bg-brand text-ink font-semibold px-2 py-0.5 rounded text-[11px]">Email:</span>
      <span class="font-normal text-ink truncate">rizqizulmiaztaalbar1@gmail.com</span>
    </div>
  </div>

  <!-- Penguasaan Bahasa -->
  <div class="mb-6">
    <h3 class="font-display font-semibold text-base text-ink mb-3">Bahasa</h3>
    <div class="space-y-3">
      {languages.map((l) => (
        <div>
          <div class="flex justify-between text-xs text-ink-light mb-1">
            <span>{l.name}</span>
            <span>{l.level}%</span>
          </div>
          <div class="h-1 rounded-full bg-amber-100 overflow-hidden">
            <div class="h-1 rounded-full bg-brand" style={`width:${l.level}%`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Keahlian Utama -->
  <div class="border-t border-ink/10 pt-6 mb-6">
    <h3 class="font-display font-semibold text-base text-ink mb-3">Keahlian Utama</h3>
    <div class="space-y-3">
      {skills.map((s) => (
        <div>
          <div class="flex justify-between text-xs text-ink-light mb-1">
            <span>{s.name}</span>
            <span>{s.level}%</span>
          </div>
          <div class="h-1 rounded-full bg-amber-100 overflow-hidden">
            <div class="h-1 rounded-full bg-brand" style={`width:${s.level}%`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Keahlian Tambahan -->
  <div class="border-t border-ink/10 pt-6 mb-6">
    <h3 class="font-display font-semibold text-base text-ink mb-3">Keahlian Tambahan</h3>
    <ul class="space-y-2.5 text-xs text-ink-light">
      {extraSkills.map((s) => (
        <li class="flex items-center gap-2.5">
          <svg class="w-3.5 h-3.5 text-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>{s}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Tombol Unduh CV -->
  <div class="border-t border-ink/10 pt-6">
    <a
      href="#"
      class="w-full bg-brand text-ink font-bold text-xs tracking-wider uppercase py-3.5 rounded flex items-center justify-center gap-2 hover:bg-amber-500 transition-colors shadow-md shadow-brand/20"
    >
      <span>UNDUH CV</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
      </svg>
    </a>
  </div>
</aside>
