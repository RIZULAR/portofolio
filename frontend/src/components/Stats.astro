---
const metrics = [
  {
    value: "2+ Tahun",
    label: "Aktif Coding",
    desc: "Mulai membangun proyek web sejak semester 2, kini semester 6.",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    value: "10+ Proyek",
    label: "Proyek Diselesaikan",
    desc: "Proyek kuliah, tugas akhir, freelance kecil, dan proyek kompetisi.",
    icon: "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z",
  },
  {
    value: "8+ Tech Stack",
    label: "Teknologi Dikuasai",
    desc: "Vue 3, Astro, Laravel, Supabase, Tailwind, TypeScript, dan lebih.",
    icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  },
  {
    value: "Semester 6",
    label: "Teknik Informatika",
    desc: "Sedang menyelesaikan studi S1 sambil aktif mengembangkan proyek.",
    icon: "M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z",
  },
];

const principles = [
  {
    title: "Clean & Maintainable Code",
    desc: "Menulis kode yang terstruktur, terdokumentasi, dan mudah dikembangkan oleh siapapun di tim.",
  },
  {
    title: "User-First & Detail-Oriented",
    desc: "Setiap keputusan UI/UX selalu didasarkan pada pengalaman pengguna nyata, bukan hanya estetika.",
  },
  {
    title: "Kolaboratif & Growth Mindset",
    desc: "Terbuka pada feedback, aktif belajar teknologi terbaru, dan senang bekerja dalam tim lintas disiplin.",
  },
];
---

<section id="stats" class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="max-w-2xl mx-auto text-center mb-8" data-aos="fade-up">
    <p class="text-amber-700 text-xs font-semibold uppercase tracking-wider mb-1.5">Pencapaian & Kualifikasi</p>
    <h2 class="font-display font-semibold text-xl sm:text-2xl text-ink">Mengapa Memilih Saya?</h2>
    <p class="mt-2 text-ink-light text-xs sm:text-sm leading-relaxed">
      Ringkasan kualifikasi teknis dan standar kerja yang saya terapkan dalam setiap pengembangan software.
    </p>
  </div>

  <!-- Metric Cards Grid -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    {metrics.map((m, idx) => (
      <div class="bg-white border border-ink/5 shadow-sm rounded-xl p-5 text-center hover:border-brand/50 transition-colors" data-aos="fade-up" data-aos-delay={(idx + 1) * 100}>
        <div class="w-10 h-10 rounded-full bg-brand/15 text-amber-800 mx-auto flex items-center justify-center mb-2.5">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={m.icon} />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-lg text-ink">{m.value}</h3>
        <p class="text-xs font-medium text-ink mt-0.5 mb-1">{m.label}</p>
        <p class="text-[11px] text-ink-light leading-relaxed">{m.desc}</p>
      </div>
    ))}
  </div>

  <!-- Developer Principles Container Card -->
  <div class="bg-white border border-ink/5 shadow-sm rounded-xl p-5 sm:p-7" data-aos="fade-up" data-aos-delay="200">
    <h3 class="font-display font-semibold text-base text-ink mb-4 text-center sm:text-left">
      Prinsip Pengembangan & Komitmen Kerja
    </h3>
    <div class="grid sm:grid-cols-3 gap-5 divide-y sm:divide-y-0 sm:divide-x divide-ink/10">
      {principles.map((p, idx) => (
        <div class={`pt-3 sm:pt-0 ${idx !== 0 ? 'sm:pl-5' : ''}`}>
          <h4 class="font-display font-semibold text-sm text-ink mb-1">{p.title}</h4>
          <p class="text-xs font-normal text-ink-light leading-relaxed">{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
