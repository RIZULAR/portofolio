---
const reviews = [
  {
    title: "Kualitas Sangat Memuaskan!",
    text: "Rayan merubah konsep wireframe kami yang rumit menjadi tampilan aplikasi web yang cepat, rapi, dan responsif hanya dalam waktu dua minggu.",
    name: "Budi Santoso",
    role: "Desainer Grafis",
  },
  {
    title: "Hasil Kerja Luar Biasa!",
    text: "Setiap tenggat waktu selalu tepat, setiap detail sangat presisi, dan struktur kode yang diserahkan sangat bersih sehingga mudah dikembangkan.",
    name: "Siti Rahma",
    role: "Pengembang Produk",
  },
  {
    title: "Sangat Profesional!",
    text: "Salah satu developer yang benar-benar paham UX dan selalu memberikan saran berharga demi kenyamanan pengguna akhir.",
    name: "Hendra Wijaya",
    role: "Pemilik Bisnis Digital",
  },
];
---
<section class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="max-w-2xl mx-auto text-center mb-10">
    <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">Testimoni Klien</p>
    <h2 class="font-display font-semibold text-2xl sm:text-3xl">Rekomendasi & Ulasan</h2>
    <p class="mt-3 text-ink-light text-sm leading-relaxed">
      Apa kata mitra dan klien setelah bekerja sama dengan saya pada proyek nyata.
    </p>
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {reviews.map((r) => (
      <div class="bg-white border border-ink/5 shadow-sm rounded-xl p-6">
        <div class="text-brand text-sm mb-3">★★★★★</div>
        <h3 class="font-display font-semibold text-base mb-2">{r.title}</h3>
        <p class="text-sm text-ink-light leading-relaxed">{r.text}</p>
        <div class="mt-5 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-ink/10 flex items-center justify-center font-display text-xs font-semibold text-ink-light">
            {r.name.split(" ").map((n) => n[0]).join("")}
          </div>
          <div>
            <p class="text-sm font-medium">{r.name}</p>
            <p class="text-xs text-ink-light">{r.role}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
