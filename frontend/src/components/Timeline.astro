---
interface Item {
  title: string;
  role?: string;
  period: string;
  subheading?: string;
  desc: string;
  image?: string;
  link?: string;
}
interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  intro: string;
  items: Item[];
  bg?: boolean;
}
const { id, eyebrow, heading, intro, items } = Astro.props;
---
<section id={id} class="mx-4 lg:mx-8 py-12 lg:py-16">
  <div class="max-w-2xl mx-auto text-center mb-10" data-aos="fade-up">
    <p class="text-brand text-sm font-medium uppercase tracking-wider mb-2">{eyebrow}</p>
    <h2 class="font-display font-semibold text-2xl sm:text-3xl">{heading}</h2>
    <p class="mt-3 text-ink-light text-sm leading-relaxed">{intro}</p>
  </div>
  
  <!-- One Big Combined Card Container matching screenshot design with clean typography -->
  <div class="bg-white rounded-2xl border border-ink/5 shadow-sm p-6 sm:p-10 divide-y divide-ink/10" data-aos="fade-up" data-aos-delay="100">
    {items.map((item, idx) => (
      <div class="grid sm:grid-cols-12 gap-4 sm:gap-8 py-8 first:pt-0 last:pb-0 items-start" data-aos="fade-up" data-aos-delay={(idx + 1) * 100}>
        <div class="sm:col-span-5">
          <h3 class="font-display font-semibold text-base sm:text-lg text-ink">{item.title}</h3>
          <div class="flex items-center gap-3 mt-2.5">
            <span class="text-sm font-normal text-ink-light">{item.role || "Student"}</span>
            <span class="bg-brand text-ink font-medium text-[11px] px-2.5 py-0.5 rounded">
              {item.period}
            </span>
          </div>
        </div>

        <div class="sm:col-span-7">
          <h4 class="font-display font-semibold text-base text-ink mb-2">
            {item.subheading || "Certificate Of Web Training"}
          </h4>
          <p class="text-sm font-normal text-ink-light leading-relaxed">
            {item.desc}
          </p>
          {item.link && (
            <div class="mt-3">
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand hover:text-amber-600 underline underline-offset-4"
              >
                <span>Lihat Demo / Detail Proyek</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          )}
          {item.image && (
            <div class="mt-4 rounded-xl overflow-hidden border border-ink/10 shadow-sm max-w-md bg-surface">
              <img src={item.image} alt={item.title} class="w-full h-auto object-cover hover:scale-105 transition-transform duration-300" width="600" height="400" loading="lazy" decoding="async" />
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
