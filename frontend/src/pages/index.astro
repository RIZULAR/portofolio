---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Stats from "../components/Stats.astro";
import Timeline from "../components/Timeline.astro";
import Portfolio from "../components/Portfolio.astro";
import Blog from "../components/Blog.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import RightNav from "../components/RightNav.astro";

const education = [
  {
    title: "Universitas Amikom Yogyakarta (Sedang Berlangsung)",
    role: "Mahasiswa Aktif",
    period: "2023 - Sekarang",
    subheading: "S1 Informatika — Semester 6",
    desc: "Fokus pada rekayasa perangkat lunak, pemrograman web fullstack, basis data, dan jaringan komputer. Aktif mengerjakan proyek nyata sebagai bagian dari persiapan karir.",
  },
  {
    title: "SMAN 3 Kota Serang",
    role: "Siswa",
    period: "2020 - 2023",
    subheading: "MIPA (Matematika dan Ilmu Pengetahuan Alam)",
    desc: "Lulus jurusan MIPA dengan minat tinggi pada logika matematika, sains, dan pemrograman komputer.",
  },
];

const workHistory = [
  {
    title: "🏆 Juara Best Research — Hackathon 2026",
    role: "Kompetisi Hackathon",
    period: "2026",
    subheading: "Sistem Konversi Nilai & SKS Magang",
    desc: "Membangun sistem informasi berbasis web untuk otomatisasi konversi kegiatan magang mahasiswa ke dalam nilai mata kuliah dan SKS akademik, dilengkapi dengan dashboard admin dan verifikasi dosen.",
    image: "/HACKATON1.webp",
  },
  {
    title: "Platform AIR.IN — ITFEST 2026",
    role: "Kompetisi ITFEST 2026",
    period: "2026",
    subheading: "Platform Monitoring & Rekomendasi Irigasi Presisi",
    desc: "Membangun platform web fullstack untuk pemantauan ketersediaan air lahan pertanian berbasis AI, peta interaktif GIS (Leaflet), integrasi cuaca realtime, dan manajemen alokasi air otomatis.",
    image: "/airin_preview.webp",
  },
  {
    title: "Fullstack Developer (Team Project)",
    role: "Mata Kuliah Proyek Pemrograman",
    period: "2026",
    subheading: "Sistem Informasi & Integrasi Magang (Magista)",
    desc: "Mengembangkan platform sistem informasi magang terintegrasi berbasis Vue 3 dan Laravel dalam tim. Bertanggung jawab pada implementasi REST API backend, autentikasi multi-role (Mahasiswa, Dosen, Admin), modul pengajuan proposal, dan dashboard pemantauan kegiatan.",
    image: "/magista.webp",
    link: "https://magista.web.id",
  },
];
---

<Layout title="Rizular — Fullstack Web Developer">
  <div class="lg:flex">
    <Sidebar />
    <main class="flex-1 min-w-0 bg-[#F0F0F6]">
      <Hero />
      <Services />
      <Stats />
      <Timeline
        id="education"
        eyebrow="Latar Belakang"
        heading="Pendidikan"
        intro="Pendidikan formal dan pelatihan profesional yang membentuk keahlian teknis saya."
        items={education}
      />
      <Timeline
        id="work-history"
        eyebrow="Proyek & Prestasi"
        heading="Proyek & Pencapaian"
        intro="Proyek nyata yang pernah saya bangun dan kompetisi yang pernah saya ikuti."
        items={workHistory}
        bg
      />
      <Portfolio />
      <Blog />
      <Contact />
      <Footer />
    </main>
    <RightNav />
  </div>
</Layout>
